# app.config - Application configuration

[app]
name = CropDoc Pro
version = 2.0.0
build = 2026.08.28
environment = production

[features]
camera = true
gallery = true
analytics = true
reports = true
filters = true
npk_analysis = true
video_recording = true
print_reports = true
multi_language = true
dark_mode = true

[limits]
max_image_size = 50MB
max_video_duration = 300
max_gallery_items = 1000
max_history_items = 100
max_reports = 50

[performance]
detection_interval = 2000
npk_update_interval = 3000
chart_update_interval = 5000
cache_enabled = true
cache_duration = 3600

[ui]
theme = dark
language = en
animations = true
sound_effects = true

[api]
base_url = https://api.cropdoc.com
timeout = 30000
retry_attempts = 3
