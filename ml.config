# ml.config - Machine learning configuration

[models]
disease_model = disease_model.h5
npk_model = npk_model.pkl
version = 3.2.0

[training]
batch_size = 32
epochs = 50
learning_rate = 0.001
validation_split = 0.2

[augmentation]
rotation_range = 20
width_shift_range = 0.2
height_shift_range = 0.2
shear_range = 0.2
zoom_range = 0.2
horizontal_flip = true
fill_mode = nearest

[inference]
confidence_threshold = 0.7
input_size = 224
normalization = true
